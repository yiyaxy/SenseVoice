# 复制为 /data/voice-stack/config/sensevoice.env 后填写真实值，不要提交真实密钥。
SENSEVOICE_API_KEY=请替换为外部访问密钥
SENSEVOICE_DEVICE=cuda:0
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_VAD_MODEL=fsmn-vad
SENSEVOICE_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
SENSEVOICE_SPK_MODEL=cam++
SENSEVOICE_SPK_MODE=vad_segment
SENSEVOICE_VAD_MAX_SEGMENT_MS=30000
SENSEVOICE_VAD_CHUNK_MS=60
SENSEVOICE_MAX_AUDIO_BYTES=20971520
SENSEVOICE_MAX_UTTERANCE_SECONDS=30
SENSEVOICE_MAX_HISTORY_TURNS=10
SENSEVOICE_SKIP_STARTUP_WARMUP=0
SENSEVOICE_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
SENSEVOICE_STREAM_QUEUE_SIZE=8
SENSEVOICE_TTS_QUEUE_SIZE=4
# 完整对话的 TTS 等待/处理中短句总预算；这是文本时长估算，不替代真实音频时长统计。
SENSEVOICE_TTS_QUEUE_MAX_SECONDS=30
SENSEVOICE_TTS_ESTIMATED_CHARS_PER_SECOND=12
SENSEVOICE_MAX_VOICEPRINT_AUDIO_BYTES=20971520
SENSEVOICE_BUILD_VERSION=development
SENSEVOICE_MODEL_REVISION=master
SENSEVOICE_VAD_MODEL_REVISION=master
SENSEVOICE_PUNC_MODEL_REVISION=master
SENSEVOICE_SPK_MODEL_REVISION=master

# 声纹管理必须由可信 BFF 使用独立密钥调用；不要把密钥提交到仓库。
SENSEVOICE_VOICEPRINT_ADMIN_KEY=请替换为声纹管理密钥
SENSEVOICE_VOICEPRINT_KEY=请替换为 Fernet 加密密钥
# 声纹识别只接受同时携带此 BFF 会话密钥和租户标识的请求。
SENSEVOICE_VOICEPRINT_SESSION_KEY=请替换为 BFF 声纹会话密钥
SENSEVOICE_VOICEPRINT_PATH=/data/voice-stack/data/voiceprints
# 起始值而非质量承诺；须用登记集之外的验证录音校准。
SENSEVOICE_VOICEPRINT_THRESHOLD=0.72
SENSEVOICE_VOICEPRINT_MARGIN=0.04

# 已有 OpenAI 兼容 LLM；若服务没有鉴权，LLM_API_KEY 可留空。
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_CHAT_COMPLETIONS_URL=
LLM_API_KEY=
LLM_MODEL=请替换为模型名
LLM_SYSTEM_PROMPT=你是实时语音对话助手，请用简洁自然的口语回答。
LLM_TIMEOUT_SECONDS=90
SENSEVOICE_MAX_LLM_OUTPUT_CHARS=12000

# GPT-SoVITS v2 API；默认音色参考音频必须位于 GPT-SoVITS 所在的 WSL 文件系统。
# 若下方 SENSEVOICE_VOICE_PROFILE_FILE 的每个启用 profile 都自带 ref_audio_path、
# prompt_text 和 prompt_lang，可将默认音色的三个 GPT_SOVITS_* 参考项留空。
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_REF_AUDIO_PATH=/data/voice-stack/voices/assistant.wav
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_TEXT_LANG=auto
GPT_SOVITS_STREAMING_MODE=3
GPT_SOVITS_SPEED_FACTOR=1.0
GPT_SOVITS_TIMEOUT_SECONDS=90
GPT_SOVITS_DEFAULT_VOICE_ID=assistant_default
GPT_SOVITS_DEFAULT_VOICE_NAME=默认助手音色
# 可选：管理员维护的音色 JSON；客户端不能直接传参考音频路径。
SENSEVOICE_VOICE_PROFILE_FILE=/data/voice-stack/config/tts-voices.json
