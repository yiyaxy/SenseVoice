+@app.websocket("/api/v1/asr/stream")
+async def stream_asr(websocket: WebSocket) -> None:
+    """接收 PCM 分帧，以累计音频重识别返回中间结果，手动提交后收口。"""
+    if not SETTINGS.service_api_key:
+        await websocket.close(code=1011, reason="服务未配置 API 密钥")
+        return
+    provided_key, accepted_subprotocol = _websocket_api_key(websocket)
+    if not secrets.compare_digest(provided_key, SETTINGS.service_api_key):
+        await websocket.close(code=4401, reason="API 密钥无效")
+        return
+    await websocket.accept(subprotocol=accepted_subprotocol)
+    await websocket.send_json({
+        "type": "session.ready",
+        "audio_format": "pcm_s16le",
+        "sample_rate": TARGET_FS,
+        "channels": 1,
+        "asr_languages": ["auto", "zh", "en", "yue", "ja", "ko"],
+        "capabilities": ["pcm_stream", "partial", "manual_commit"],
+        "auto_vad": False,
+        "max_utterance_seconds": SETTINGS.max_utterance_seconds,
+    })
+    language = "auto"
+    audio_buffer = bytearray()
+    last_partial_bytes = 0
+    first_partial_ms = None
+    utterance_started = None
+    rejected_utterance = False
+    duration_limit = int(SETTINGS.max_utterance_seconds * TARGET_FS * 2)
+
+    def reset_utterance() -> None:
+        """清理当前话轮，不改变连接级语言配置。"""
+        nonlocal last_partial_bytes, first_partial_ms, utterance_started, rejected_utterance
+        audio_buffer.clear()
+        last_partial_bytes = 0
+        first_partial_ms = None
+        utterance_started = None
+        rejected_utterance = False
+
+    try:
+        while True:
+            message = await websocket.receive()
+            if message.get("type") == "websocket.disconnect":
+                return
+            audio_chunk = message.get("bytes")
+            if audio_chunk is not None:
+                if not audio_chunk or rejected_utterance:
+                    continue
+                next_size = len(audio_buffer) + len(audio_chunk)
+                if next_size > min(SETTINGS.max_audio_bytes, duration_limit):
+                    reset_utterance()
+                    # 超限后丢弃整轮，直到 commit；不能把尾部误当作完整录音。
+                    rejected_utterance = True
+                    code = "audio_too_large" if next_size > SETTINGS.max_audio_bytes else "audio_too_long"
+                    await websocket.send_json({"type": "error", "code": code})
+                    continue
+                if utterance_started is None:
+                    utterance_started = time.monotonic()
+                    await websocket.send_json({"type": "asr.processing"})
+                audio_buffer.extend(audio_chunk)
+                # SenseVoice 不是原生增量模型；约每新增 800ms 音频重识别累计内容。
+                if len(audio_buffer) - last_partial_bytes < TARGET_FS * 2 * 0.8:
+                    continue
+                if len(audio_buffer) % 2 or STREAM_ASR_GATE.locked():
+                    continue
+                last_partial_bytes = len(audio_buffer)
+                try:
+                    async with STREAM_ASR_GATE:
+                        partial = await asyncio.to_thread(
+                            _transcribe_audio, bytes(audio_buffer), language, True
+                        )
+                except ClientInputError:
+                    continue
+                except Exception:  # noqa: BLE001
+                    LOGGER.exception("实时 ASR 中间结果推理失败")
+                    continue
+                if partial.get("text"):
+                    elapsed_ms = round((time.monotonic() - utterance_started) * 1000)
+                    if first_partial_ms is None:
+                        first_partial_ms = elapsed_ms
+                    await websocket.send_json({
+                        "type": "asr.partial",
+                        "text": partial["text"],
+                        "language": partial["language"],
+                        "elapsed_ms": elapsed_ms,
+                    })
+                continue
+
+            raw_event = message.get("text")
+            if raw_event is None:
+                continue
+            try:
+                event = json.loads(raw_event)
+            except json.JSONDecodeError:
+                await websocket.send_json({"type": "error", "code": "invalid_json"})
+                continue
+            if not isinstance(event, dict):
+                await websocket.send_json({"type": "error", "code": "invalid_event"})
+                continue
+            event_type = event.get("type")
+            if event_type == "configure":
+                requested = event.get("language", language)
+                if not isinstance(requested, str) or requested not in SUPPORTED_ASR_LANGUAGES:
+                    await websocket.send_json({"type": "error", "code": "unsupported_asr_language"})
+                    continue
+                if event.get("auto_vad", False) is not False:
+                    await websocket.send_json({"type": "error", "code": "auto_vad_not_supported"})
+                    continue
+                if (event.get("sample_rate", TARGET_FS) != TARGET_FS
+                        or event.get("channels", 1) != 1
+                        or event.get("audio_format", "pcm_s16le") != "pcm_s16le"):
+                    await websocket.send_json({"type": "error", "code": "unsupported_audio_format"})
+                    continue
+                language = requested
+                await websocket.send_json({"type": "session.configured", "language": language, "auto_vad": False})
+            elif event_type == "commit":
+                if rejected_utterance:
+                    reset_utterance()
+                    await websocket.send_json({"type": "error", "code": "audio_discarded"})
+                    continue
+                if not audio_buffer:
+                    await websocket.send_json({"type": "error", "code": "invalid_audio"})
+                    continue
+                if STREAM_ASR_GATE.locked():
+                    # 繁忙时保留本轮音频，客户端可以重试提交，不能静默丢失最终结果。
+                    await websocket.send_json({"type": "error", "code": "server_busy"})
+                    continue
+                commit_started = time.monotonic()
+                try:
+                    async with STREAM_ASR_GATE:
+                        final = await asyncio.to_thread(
+                            _transcribe_audio, bytes(audio_buffer), language, True
+                        )
+                except ClientInputError as error:
+                    await websocket.send_json({"type": "error", "code": "invalid_audio", "message": str(error)})
+                    continue
+                except Exception:  # noqa: BLE001
+                    LOGGER.exception("实时 ASR 最终结果推理失败")
+                    await websocket.send_json({"type": "error", "code": "asr_failed"})
+                    continue
+                final_ms = round((time.monotonic() - utterance_started) * 1000)
+                await websocket.send_json({
+                    "type": "asr.final", **final,
+                    "first_partial_ms": first_partial_ms,
+                    "final_ms": final_ms,
+                    "commit_latency_ms": round((time.monotonic() - commit_started) * 1000),
+                })
+                await websocket.send_json({"type": "asr.completed", "final_ms": final_ms})
+                reset_utterance()
+            elif event_type == "reset":
+                reset_utterance()
+                await websocket.send_json({"type": "session.reset"})
+            elif event_type == "ping":
+                await websocket.send_json({"type": "pong"})
+            else:
+                await websocket.send_json({"type": "error", "code": "unknown_event"})
+    except WebSocketDisconnect:
+        return
+
+
